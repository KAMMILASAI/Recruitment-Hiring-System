<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>OfferSalary</name>
        <dataType>Currency</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!$Record.Application__r.Job__r.Minimum_Salary__c})),
        NOT(ISBLANK({!$Record.Application__r.Job__r.Maximum_Salary__c}))
    ),
    (
        {!$Record.Application__r.Job__r.Minimum_Salary__c}
        +
        {!$Record.Application__r.Job__r.Maximum_Salary__c}
    ) / 2,
    IF(
        NOT(ISBLANK({!$Record.Application__r.Job__r.Minimum_Salary__c})),
        {!$Record.Application__r.Job__r.Minimum_Salary__c},
        {!$Record.Application__r.Job__r.Maximum_Salary__c}
    )
)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Create Offer Automatically {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Offer Automatically</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Offer_Creation</name>
        <label>Offer Creation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Application__c</field>
            <value>
                <elementReference>$Record.Application__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Offer_Status__c</field>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Salary__c</field>
            <value>
                <elementReference>OfferSalary</elementReference>
            </value>
        </inputAssignments>
        <object>Offer__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>update_application_Status</name>
        <label>update application Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Offer_Creation</targetReference>
        </connector>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Selected</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Application__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>update_application_Status</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Result__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pass</stringValue>
            </value>
        </filters>
        <object>Interview__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
